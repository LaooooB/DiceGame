[gd_scene format=3]

[node name="DesktopShell" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 16

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 30
text = "骰子回响"

[node name="Wallet" type="Label" parent="Layout/Header"]
layout_mode = 2
horizontal_alignment = 2

[node name="Breadcrumb" type="Label" parent="Layout"]
layout_mode = 2
text = "城镇准备 → 选择骰子与区域 → 远征 → 回城建设"

[node name="Content" type="VBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Toast" type="Label" parent="Layout"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
autowrap_mode = 3

[node name="Fps" type="Label" parent="Layout"]
layout_mode = 2
visible = false
