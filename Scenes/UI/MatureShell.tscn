[node name="Text" type="RichTextLabel" parent="Layout/Pages/Help/Scroll"]
custom_minimum_size = Vector2(0, 900)
layout_mode = 2
size_flags_horizontal = 3
fit_content = true
bbcode_enabled = true
theme_override_font_sizes/normal_font_size = 21
theme_override_font_sizes/bold_font_size = 25
text = "[b]城镇[/b]\n选择地块进行建设或升级。按住城镇棋盘瞄准，松手派遣。\n\n[b]远征[/b]\n从城镇点击“开始游戏”。选区域后可直接出发；需要调整骰组时再进入骰组页面。\n\n[b]战斗[/b]\n按住战场瞄准，松开发射。拖动骰子到空位可移动；同种、同点才能合成。24个席位全部在同一屏幕内。\n\n[b]强化[/b]\n三级选择 A/B。六级会先为最终骰种重新选择 A/B，再选择 C/D。选择期间战斗暂停。\n\n[b]深潜[/b]\n同一区域使用不同主骰首次通关可获得齿轮。满足条件后可进入下一层。"

